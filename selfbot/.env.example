# ============================================================
#  CaptureFruitHoHoHub - Self Bot  |  arquivo de exemplo
#  Copie para ".env" (ou use o botao "Aplicar Token" do app)
#  NUNCA envie este arquivo com o seu token para o GitHub.
# ============================================================

# Obrigatorio: token da SUA conta (o app grava esta linha automaticamente)
DISCORD_TOKEN=

# Prefixo dos comandos
COMMAND_PREFIX=!

# Presenca inicial: online | idle | dnd | invisible
STATUS=online

# Texto do "status personalizado" (deixe vazio para nao usar)
CUSTOM_STATUS_TEXT=

# Mostrar menu de ajuda no terminal?
SHOW_BANNER=true

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Gravar log em arquivo (selfbot/logs/bot-AAAA-MM-DD.log)
LOG_TO_FILE=true

# Liberar comandos apenas em canais/guilds especificos (vazio = usa em qualquer lugar)
# Ex.: ALLOWED_GUILD_IDS=1234567890,9876543210
ALLOWED_GUILD_IDS=

# Responder aos proprios comandos (padrao de um self bot)
RESPOND_TO_SELF=true

# Responder tambem a comandos escritos por OUTRAS pessoas (false = mais seguro/discreto)
RESPOND_TO_OTHERS=false

# Enviar evento de "ping" para o app (a cada N segundos, 0 = desativado)
HEARTBEAT_INTERVAL=30
